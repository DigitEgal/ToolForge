{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolForge Pilot Aufgabenplan v1",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "goal",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "instruction",
          "depends_on",
          "files",
          "acceptance",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,60}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "estimate": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "max_repairs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "argv"
              ],
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "cwd": {
                  "type": "string",
                  "default": "."
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600
                }
              }
            }
          }
        }
      }
    }
  }
}